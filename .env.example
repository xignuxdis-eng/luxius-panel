# =============================================================================
# LuXius — variables de entorno
#
# Copiar a `.env` en la raíz del repo y completar. NUNCA versionar el `.env`.
# =============================================================================

# -----------------------------------------------------------------------------
# Base de datos — Supabase (Session pooler, puerto 5432)
# -----------------------------------------------------------------------------
# Obtener en: Supabase > Settings > Database > Connection string > URI
# Usar SIEMPRE el Session pooler (puerto 5432), no la conexión directa: Supabase
# cierra conexiones ociosas del pool directo y rompe llamadas largas de gunicorn.
# IMPORTANTE: copiar sin saltos de línea. Un "\n" pegado desde el dashboard
# rompe el arranque del backend con "postgres\n does not exist".
DATABASE_URL=postgresql://<user>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# -----------------------------------------------------------------------------
# Seguridad — JWT
# -----------------------------------------------------------------------------
# Generar con: python -c "import secrets; print(secrets.token_hex(64))"
# Si se deja vacío, el backend genera una clave aleatoria POR PROCESO: el
# servicio arranca, pero ningún token sobrevive a un reinicio.
JWT_SECRET_KEY=

# -----------------------------------------------------------------------------
# Inteligencia artificial (Xana)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# Cloudflare R2 — almacenamiento multimedia
# -----------------------------------------------------------------------------
# Crear el token en Cloudflare > R2 > Manage R2 API Tokens, con permiso
# "Object Read & Write" sobre el bucket. Ver P0.1 del roadmap: las credenciales
# anteriores estuvieron expuestas en el historial público del repo.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=luxius-media
# Opcional: si se omite, se deriva de R2_ACCOUNT_ID.
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com

# -----------------------------------------------------------------------------
# Google Drive (OAuth de usuario — token.json, NO Service Account)
# -----------------------------------------------------------------------------
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_OAUTH_TOKEN_FILE=token.json

# -----------------------------------------------------------------------------
# Migración / Pipeline R2 → Drive
# -----------------------------------------------------------------------------
DIAS_ANTIGUEDAD=5
DRY_RUN=true
MAX_REINTENTOS_DRIVE=5
BACKOFF_BASE_SEGUNDOS=2

# -----------------------------------------------------------------------------
# SMTP — notificaciones de archivos huérfanos
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# -----------------------------------------------------------------------------
# Telegram (opcional — bot de alertas del taller)
# -----------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=          # entregado por @BotFather
# TELEGRAM_ADMIN_CHAT_ID=      # chat que recibe las alertas
# TELEGRAM_WEBHOOK_SECRET=     # se deriva de JWT_SECRET_KEY si se omite

# -----------------------------------------------------------------------------
# Opcionales
# -----------------------------------------------------------------------------
# REDIS_URL=                   # limita el login de forma compartida entre workers
# TELEGRAM_AUTO_WEBHOOK=0      # poner en 0 para NO re-registrar el webhook al arrancar
# FLASK_ENV=production