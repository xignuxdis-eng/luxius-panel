import { useState, useEffect } from "react";
import { apiService, Material } from "../../../services/api";

interface RentabilidadData {
  materialId: number;
  materialName: string;
  categoria: string;
  precioInterno: number;
  precioCliente: number;
  margen: number;
  rentabilidad: number;
  stock: number;
  valorInventario: number;
  moneda: 'ARS' | 'USD';
}

interface ExchangeRate {
  USD: number;
  lastUpdate: string;
}

export default function AdminReportes() {
  const [materials, setMaterials] = useState<Material[]>([]);
  const [rentabilidadData, setRentabilidadData] = useState<RentabilidadData[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);
  const [selectedCategory, setSelectedCategory] = useState<string>('all');
  const [selectedTimeframe, setSelectedTimeframe] = useState<'month' | 'quarter' | 'year'>('month');
  const [exchangeRate, setExchangeRate] = useState<ExchangeRate>({ USD: 0, lastUpdate: '' });

  useEffect(() => {
    fetchData();
  }, []);

  useEffect(() => {
    if (materials.length > 0) {
      calculateRentabilidad();
    }
  }, [materials, selectedTimeframe]);

  const fetchData = async () => {
    try {
      setLoading(true);
      const [materialsData] = await Promise.all([
        apiService.getMaterials(),
        fetchExchangeRate()
      ]);
      
      setMaterials(materialsData || []);
      setError(null);
    } catch (err) {
      console.error('Error fetching data:', err);
      setError('Error al cargar datos');
    } finally {
      setLoading(false);
    }
  };

  const fetchExchangeRate = async () => {
    try {
      const response = await fetch('https://api.exchangerate-api.com/v4/latest/USD');
      const data = await response.json();
      setExchangeRate({
        USD: data.rates.ARS,
        lastUpdate: new Date().toLocaleString('es-AR')
      });
    } catch (error) {
      console.error('Error fetching exchange rate:', error);
      setExchangeRate({
        USD: 1000,
        lastUpdate: new Date().toLocaleString('es-AR')
      });
    }
  };

  const calculateRentabilidad = () => {
    const rentabilidad = materials.map(material => {
      const precioInterno = material.precio_interno || 0;
      const precioCliente = material.precio_por_m2 || 0;
      const moneda = (material as any).moneda || 'ARS';
      
      // Convertir a ARS para cálculos
      const precioInternoARS = moneda === 'USD' ? precioInterno * exchangeRate.USD : precioInterno;
      const precioClienteARS = moneda === 'USD' ? precioCliente * exchangeRate.USD : precioCliente;
      
      const margen = precioInterno > 0 ? ((precioCliente - precioInterno) / precioInterno) * 100 : 0;
      const valorInventario = material.stock * precioInternoARS;
      
      // Simular rentabilidad basada en ventas históricas (en un sistema real vendría de la BD)
      const ventasSimuladas = Math.random() * 100; // Simulación
      const rentabilidad = (margen * ventasSimuladas) / 100;

      return {
        materialId: material.id,
        materialName: material.nombre,
        categoria: material.categoria,
        precioInterno,
        precioCliente,
        margen,
        rentabilidad,
        stock: material.stock,
        valorInventario,
        moneda
      };
    });

    setRentabilidadData(rentabilidad);
  };

  const filteredData = rentabilidadData.filter(item => {
    return selectedCategory === 'all' || item.categoria === selectedCategory;
  });

  const getCategoryStats = () => {
    const stats: { [key: string]: { total: number; promedio: number; count: number } } = {};
    
    rentabilidadData.forEach(item => {
      if (!stats[item.categoria]) {
        stats[item.categoria] = { total: 0, promedio: 0, count: 0 };
      }
      stats[item.categoria].total += item.rentabilidad;
      stats[item.categoria].count += 1;
    });

    Object.keys(stats).forEach(cat => {
      stats[cat].promedio = stats[cat].total / stats[cat].count;
    });

    return stats;
  };

  const getRentabilidadColor = (rentabilidad: number) => {
    if (rentabilidad < 0) return 'text-red-600 bg-red-100';
    if (rentabilidad < 20) return 'text-yellow-600 bg-yellow-100';
    if (rentabilidad < 50) return 'text-orange-600 bg-orange-100';
    return 'text-green-600 bg-green-100';
  };

  const formatCurrency = (amount: number, currency: 'ARS' | 'USD') => {
    if (currency === 'USD') {
      return `$${amount.toFixed(2)} USD`;
    }
    return `$${amount.toFixed(2)}`;
  };

  if (loading) {
    return (
      <div className="space-y-6">
        <div className="bg-white rounded-lg shadow-sm p-6 border border-gray-200">
          <div className="text-center">
            <div className="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600 mx-auto mb-4"></div>
            <p className="text-gray-600">Cargando reportes...</p>
          </div>
        </div>
      </div>
    );
  }

  const categoryStats = getCategoryStats();

  return (
    <div className="space-y-6">
      {/* Header */}
      <div className="bg-white rounded-lg shadow-sm p-6 border border-gray-200">
        <h1 className="text-2xl font-bold text-gray-800 mb-2">
          Reportes de Rentabilidad 📊
        </h1>
        <p className="text-gray-600">
          Análisis detallado de rentabilidad por material y categoría.
        </p>
      </div>

      {/* Filtros */}
      <div className="bg-white rounded-lg shadow-sm p-6 border border-gray-200">
        <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div>
            <label className="block text-sm font-medium text-gray-700 mb-2">
              Categoría
            </label>
            <select
              value={selectedCategory}
              onChange={(e) => setSelectedCategory(e.target.value)}
              className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
            >
              <option value="all">Todas las categorías</option>
              {[...new Set(materials.map(m => m.categoria))].sort().map(category => (
                <option key={category} value={category}>{category}</option>
              ))}
            </select>
          </div>
          <div>
            <label className="block text-sm font-medium text-gray-700 mb-2">
              Período
            </label>
            <select
              value={selectedTimeframe}
              onChange={(e) => setSelectedTimeframe(e.target.value as 'month' | 'quarter' | 'year')}
              className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
            >
              <option value="month">Último Mes</option>
              <option value="quarter">Último Trimestre</option>
              <option value="year">Último Año</option>
            </select>
          </div>
          <div className="flex items-end">
            <button
              onClick={fetchExchangeRate}
              className="w-full bg-green-600 hover:bg-green-700 text-white py-2 px-4 rounded-md transition-colors"
            >
              Actualizar Cotización USD
            </button>
          </div>
        </div>
      </div>

      {/* Estadísticas por Categoría */}
      <div className="bg-white rounded-lg shadow-sm p-6 border border-gray-200">
        <h2 className="text-lg font-semibold text-gray-800 mb-4">📈 Rentabilidad por Categoría</h2>
        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
          {Object.entries(categoryStats).map(([category, stats]) => (
            <div key={category} className="bg-gray-50 rounded-lg p-4">
              <div className="flex items-center justify-between">
                <div>
                  <p className="text-sm font-medium text-gray-600">{category}</p>
                  <p className="text-2xl font-bold text-gray-900 mt-1">
                    {stats.promedio.toFixed(1)}%
                  </p>
                  <p className="text-sm text-gray-500 mt-1">
                    {stats.count} materiales
                  </p>
                </div>
                <div className="p-3 rounded-lg bg-blue-100">
                  <span className="text-2xl">📊</span>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      {/* Tabla de Rentabilidad */}
      <div className="bg-white rounded-lg shadow-sm border border-gray-200">
        <div className="p-6 border-b border-gray-200">
          <h2 className="text-lg font-semibold text-gray-800">
            Rentabilidad por Material ({filteredData.length})
          </h2>
        </div>
        <div className="overflow-x-auto">
          <table className="min-w-full divide-y divide-gray-200">
            <thead className="bg-gray-50">
              <tr>
                <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  Material
                </th>
                <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  Categoría
                </th>
                <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  Precio Interno
                </th>
                <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  Precio Cliente
                </th>
                <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  Margen
                </th>
                <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  Rentabilidad
                </th>
                <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  Valor Inventario
                </th>
              </tr>
            </thead>
            <tbody className="bg-white divide-y divide-gray-200">
              {filteredData.map((item) => (
                <tr key={item.materialId} className="hover:bg-gray-50">
                  <td className="px-6 py-4 whitespace-nowrap">
                    <div className="text-sm font-medium text-gray-900">
                      {item.materialName}
                    </div>
                    <div className="text-sm text-gray-500">
                      Stock: {item.stock}
                    </div>
                  </td>
                  <td className="px-6 py-4 whitespace-nowrap">
                    <span className="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-gray-100 text-gray-800">
                      {item.categoria}
                    </span>
                  </td>
                  <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                    {formatCurrency(item.precioInterno, item.moneda)}
                  </td>
                  <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                    {formatCurrency(item.precioCliente, item.moneda)}
                  </td>
                  <td className="px-6 py-4 whitespace-nowrap">
                    <span className={`inline-flex px-2 py-1 text-xs font-semibold rounded-full ${
                      item.margen < 0 ? 'text-red-600 bg-red-100' : 
                      item.margen < 20 ? 'text-yellow-600 bg-yellow-100' : 
                      item.margen < 50 ? 'text-orange-600 bg-orange-100' : 
                      'text-green-600 bg-green-100'
                    }`}>
                      {item.margen.toFixed(1)}%
                    </span>
                  </td>
                  <td className="px-6 py-4 whitespace-nowrap">
                    <span className={`inline-flex px-2 py-1 text-xs font-semibold rounded-full ${getRentabilidadColor(item.rentabilidad)}`}>
                      {item.rentabilidad.toFixed(1)}%
                    </span>
                  </td>
                  <td className="px-6 py-4 whitespace-nowrap text-sm font-bold text-gray-900">
                    ${item.valorInventario.toLocaleString()}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      {/* Resumen */}
      <div className="bg-white rounded-lg shadow-sm p-6 border border-gray-200">
        <h2 className="text-lg font-semibold text-gray-800 mb-4">📋 Resumen de Rentabilidad</h2>
        <div className="grid grid-cols-1 md:grid-cols-4 gap-4">
          <div className="bg-blue-50 rounded-lg p-4">
            <p className="text-sm font-medium text-blue-600">Rentabilidad Promedio</p>
            <p className="text-2xl font-bold text-blue-900">
              {(rentabilidadData.reduce((sum, item) => sum + item.rentabilidad, 0) / rentabilidadData.length).toFixed(1)}%
            </p>
          </div>
          <div className="bg-green-50 rounded-lg p-4">
            <p className="text-sm font-medium text-green-600">Valor Total Inventario</p>
            <p className="text-2xl font-bold text-green-900">
              ${rentabilidadData.reduce((sum, item) => sum + item.valorInventario, 0).toLocaleString()}
            </p>
          </div>
          <div className="bg-purple-50 rounded-lg p-4">
            <p className="text-sm font-medium text-purple-600">Materiales Rentables</p>
            <p className="text-2xl font-bold text-purple-900">
              {rentabilidadData.filter(item => item.rentabilidad > 20).length}
            </p>
          </div>
          <div className="bg-orange-50 rounded-lg p-4">
            <p className="text-sm font-medium text-orange-600">Cotización USD</p>
            <p className="text-2xl font-bold text-orange-900">
              ${exchangeRate.USD?.toFixed(2) || 'N/A'}
            </p>
          </div>
        </div>
      </div>
    </div>
  );
} 