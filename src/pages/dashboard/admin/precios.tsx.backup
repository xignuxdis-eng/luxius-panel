import { useState, useEffect } from "react";
import { apiService, Material } from "../../../services/api";

interface PricingData {
  materialId: number;
  materialName: string;
  categoria: string;
  precioInterno: number;
  precioCliente: number;
  precioPorM2: number;
  precioPorUnidad: number;
  margen: number;
  unidad: string;
  moneda: 'ARS' | 'USD';
}

interface ExchangeRate {
  USD: number;
  lastUpdate: string;
}

export default function AdminPrecios() {
  const [materials, setMaterials] = useState<Material[]>([]);
  const [pricingData, setPricingData] = useState<PricingData[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);
  const [selectedCategory, setSelectedCategory] = useState<string>('all');
  const [searchQuery, setSearchQuery] = useState('');
  const [showPricingModal, setShowPricingModal] = useState(false);
  const [selectedMaterial, setSelectedMaterial] = useState<Material | null>(null);
  const [editingPrices, setEditingPrices] = useState({
    precio_interno: 0,
    precio_por_m2: 0,
    precio_por_unidad: 0,
    moneda: 'ARS' as 'ARS' | 'USD'
  });
  const [exchangeRate, setExchangeRate] = useState<ExchangeRate>({ USD: 0, lastUpdate: '' });
  const [showExchangeRateModal, setShowExchangeRateModal] = useState(false);

  useEffect(() => {
    fetchMaterials();
    fetchExchangeRate();
  }, []);

  const fetchExchangeRate = async () => {
    try {
      // API gratuita para obtener cotización del dólar
      const response = await fetch('https://api.exchangerate-api.com/v4/latest/USD');
      const data = await response.json();
      setExchangeRate({
        USD: data.rates.ARS,
        lastUpdate: new Date().toLocaleString('es-AR')
      });
    } catch (error) {
      console.error('Error fetching exchange rate:', error);
      // Fallback con cotización manual
      setExchangeRate({
        USD: 1000, // Cotización de ejemplo
        lastUpdate: new Date().toLocaleString('es-AR')
      });
    }
  };

  useEffect(() => {
    if (materials.length > 0) {
             const pricing = materials.map(material => ({
         materialId: material.id,
         materialName: material.nombre,
         categoria: material.categoria,
         precioInterno: material.precio_interno || 0,
         precioCliente: material.precio_por_m2 || 0,
         precioPorM2: material.precio_por_m2 || 0,
         precioPorUnidad: material.precio_por_unidad || 0,
         margen: calculateMargin(material.precio_interno || 0, material.precio_por_m2 || 0),
         unidad: material.unidad,
         moneda: (material as any).moneda || 'ARS'
       }));
      setPricingData(pricing);
    }
  }, [materials]);

  const fetchMaterials = async () => {
    try {
      setLoading(true);
      const response = await apiService.getMaterials();
      setMaterials(response || []);
      setError(null);
    } catch (err) {
      console.error('Error fetching materials:', err);
      setError('Error al cargar materiales');
    } finally {
      setLoading(false);
    }
  };

  const calculateMargin = (precioInterno: number, precioCliente: number): number => {
    if (precioInterno === 0) return 0;
    return ((precioCliente - precioInterno) / precioInterno) * 100;
  };

  const filteredPricingData = pricingData.filter(item => {
    const matchesCategory = selectedCategory === 'all' || item.categoria === selectedCategory;
    const matchesSearch = item.materialName.toLowerCase().includes(searchQuery.toLowerCase());
    return matchesCategory && matchesSearch;
  });

  const handleEditPricing = (material: Material) => {
    setSelectedMaterial(material);
    setEditingPrices({
      precio_interno: material.precio_interno || 0,
      precio_por_m2: material.precio_por_m2 || 0,
      precio_por_unidad: material.precio_por_unidad || 0,
      moneda: (material as any).moneda || 'ARS'
    });
    setShowPricingModal(true);
  };

  const handleSavePricing = async () => {
    if (!selectedMaterial) return;

    try {
      // Aquí iría la llamada a la API para actualizar precios
      // await apiService.updateMaterialPricing(selectedMaterial.id, editingPrices);
      
      // Actualizar localmente
      const updatedMaterials = materials.map(m => 
        m.id === selectedMaterial.id 
          ? { ...m, ...editingPrices }
          : m
      );
      setMaterials(updatedMaterials);
      setShowPricingModal(false);
      setSelectedMaterial(null);
    } catch (err) {
      console.error('Error updating pricing:', err);
    }
  };

  const getCategoryColor = (category: string) => {
    switch (category.toLowerCase()) {
      case 'banner': return 'text-green-600 bg-green-100';
      case 'vinilo': return 'text-blue-600 bg-blue-100';
      case 'papel': return 'text-yellow-600 bg-yellow-100';
      case 'tela': return 'text-purple-600 bg-purple-100';
      case 'lona': return 'text-indigo-600 bg-indigo-100';
      case 'tinta': return 'text-cyan-600 bg-cyan-100';
      case 'laca': return 'text-emerald-600 bg-emerald-100';
      case 'solvente': return 'text-slate-600 bg-slate-100';
      default: return 'text-gray-600 bg-gray-100';
    }
  };

  const getMarginColor = (margin: number) => {
    if (margin < 0) return 'text-red-600 bg-red-100';
    if (margin < 20) return 'text-yellow-600 bg-yellow-100';
    if (margin < 50) return 'text-orange-600 bg-orange-100';
    return 'text-green-600 bg-green-100';
  };

  const formatCurrency = (amount: number, currency: 'ARS' | 'USD') => {
    if (currency === 'USD') {
      return `$${amount.toFixed(2)} USD`;
    }
    return `$${amount.toFixed(2)}`;
  };

  const convertToARS = (amount: number, currency: 'ARS' | 'USD') => {
    if (currency === 'USD') {
      return amount * exchangeRate.USD;
    }
    return amount;
  };

  if (loading) {
    return (
      <div className="space-y-6">
        <div className="bg-white rounded-lg shadow-sm p-6 border border-gray-200">
          <div className="text-center">
            <div className="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600 mx-auto mb-4"></div>
            <p className="text-gray-600">Cargando precios...</p>
          </div>
        </div>
      </div>
    );
  }

  return (
    <div className="space-y-6">
      {/* Header */}
      <div className="bg-white rounded-lg shadow-sm p-6 border border-gray-200">
        <h1 className="text-2xl font-bold text-gray-800 mb-2">
          Gestión de Precios y Presupuestos 💰
        </h1>
        <p className="text-gray-600">
          Administra precios, márgenes y genera presupuestos para clientes.
        </p>
      </div>

      {/* Estadísticas de Precios */}
      <div className="grid grid-cols-1 md:grid-cols-4 gap-4">
                 <div className="bg-white rounded-lg shadow-sm p-6 border border-gray-200">
           <div className="flex items-center">
             <div className="p-2 bg-blue-100 rounded-lg">
               <span className="text-2xl">💰</span>
             </div>
             <div className="ml-4">
               <p className="text-sm font-medium text-gray-600">Valor Total Inventario</p>
               <p className="text-2xl font-bold text-gray-900">
                 ${materials.reduce((sum, m) => {
                   const precio = m.precio_interno || 0;
                   const moneda = (m as any).moneda || 'ARS';
                   return sum + (m.stock * convertToARS(precio, moneda));
                 }, 0).toLocaleString()}
               </p>
               <p className="text-xs text-gray-500">
                 Cotización USD: ${exchangeRate.USD?.toFixed(2) || 'N/A'}
               </p>
             </div>
           </div>
         </div>
        <div className="bg-white rounded-lg shadow-sm p-6 border border-gray-200">
          <div className="flex items-center">
            <div className="p-2 bg-green-100 rounded-lg">
              <span className="text-2xl">📈</span>
            </div>
            <div className="ml-4">
              <p className="text-sm font-medium text-gray-600">Margen Promedio</p>
              <p className="text-2xl font-bold text-gray-900">
                {pricingData.length > 0 
                  ? (pricingData.reduce((sum, p) => sum + p.margen, 0) / pricingData.length).toFixed(1)
                  : 0}%
              </p>
            </div>
          </div>
        </div>
        <div className="bg-white rounded-lg shadow-sm p-6 border border-gray-200">
          <div className="flex items-center">
            <div className="p-2 bg-purple-100 rounded-lg">
              <span className="text-2xl">🎯</span>
            </div>
            <div className="ml-4">
              <p className="text-sm font-medium text-gray-600">Materiales con Precio</p>
              <p className="text-2xl font-bold text-gray-900">
                {materials.filter(m => m.precio_por_m2 > 0).length}
              </p>
            </div>
          </div>
        </div>
        <div className="bg-white rounded-lg shadow-sm p-6 border border-gray-200">
          <div className="flex items-center">
            <div className="p-2 bg-yellow-100 rounded-lg">
              <span className="text-2xl">⚠️</span>
            </div>
            <div className="ml-4">
              <p className="text-sm font-medium text-gray-600">Sin Precio</p>
              <p className="text-2xl font-bold text-gray-900">
                {materials.filter(m => m.precio_por_m2 === 0).length}
              </p>
            </div>
          </div>
        </div>
      </div>

             {/* Cotización del Dólar */}
       <div className="bg-white rounded-lg shadow-sm p-6 border border-gray-200">
         <div className="flex justify-between items-center">
           <div>
             <h3 className="text-lg font-semibold text-gray-800 mb-2">💱 Cotización del Dólar</h3>
             <p className="text-sm text-gray-600">
               Última actualización: {exchangeRate.lastUpdate}
             </p>
           </div>
           <div className="text-right">
             <p className="text-2xl font-bold text-green-600">
               ${exchangeRate.USD?.toFixed(2) || 'N/A'}
             </p>
             <button
               onClick={fetchExchangeRate}
               className="mt-2 bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-md text-sm transition-colors"
             >
               Actualizar Cotización
             </button>
           </div>
         </div>
       </div>

       {/* Filtros */}
       <div className="bg-white rounded-lg shadow-sm p-6 border border-gray-200">
         <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div>
            <label className="block text-sm font-medium text-gray-700 mb-2">
              Buscar Material
            </label>
            <input
              type="text"
              placeholder="Buscar por nombre..."
              value={searchQuery}
              onChange={(e) => setSearchQuery(e.target.value)}
              className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
            />
          </div>
          <div>
            <label className="block text-sm font-medium text-gray-700 mb-2">
              Categoría
            </label>
            <select
              value={selectedCategory}
              onChange={(e) => setSelectedCategory(e.target.value)}
              className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
            >
              <option value="all">Todas las categorías</option>
              {[...new Set(materials.map(m => m.categoria))].sort().map(category => (
                <option key={category} value={category}>{category}</option>
              ))}
            </select>
          </div>
          <div className="flex items-end">
            <button
              onClick={() => {
                setSearchQuery('');
                setSelectedCategory('all');
              }}
              className="w-full bg-gray-600 hover:bg-gray-700 text-white py-2 px-4 rounded-md transition-colors"
            >
              Limpiar Filtros
            </button>
          </div>
        </div>
      </div>

      {/* Tabla de Precios */}
      <div className="bg-white rounded-lg shadow-sm border border-gray-200">
        <div className="p-6 border-b border-gray-200">
          <h2 className="text-lg font-semibold text-gray-800">
            Precios de Materiales ({filteredPricingData.length})
          </h2>
        </div>
        <div className="overflow-x-auto">
          <table className="min-w-full divide-y divide-gray-200">
            <thead className="bg-gray-50">
              <tr>
                <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  Material
                </th>
                <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  Categoría
                </th>
                                 <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                   Precio Interno
                 </th>
                 <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                   Precio Cliente
                 </th>
                 <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                   Moneda
                 </th>
                <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  Margen
                </th>
                <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  Acciones
                </th>
              </tr>
            </thead>
            <tbody className="bg-white divide-y divide-gray-200">
              {filteredPricingData.map((item) => (
                <tr key={item.materialId} className="hover:bg-gray-50">
                  <td className="px-6 py-4 whitespace-nowrap">
                    <div className="text-sm font-medium text-gray-900">
                      {item.materialName}
                    </div>
                    <div className="text-sm text-gray-500">
                      {item.unidad}
                    </div>
                  </td>
                  <td className="px-6 py-4 whitespace-nowrap">
                    <span className={`inline-flex px-2 py-1 text-xs font-semibold rounded-full ${getCategoryColor(item.categoria)}`}>
                      {item.categoria}
                    </span>
                  </td>
                                     <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                     {formatCurrency(item.precioInterno, item.moneda)}
                   </td>
                   <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                     {formatCurrency(item.precioCliente, item.moneda)}
                   </td>
                   <td className="px-6 py-4 whitespace-nowrap">
                     <span className={`inline-flex px-2 py-1 text-xs font-semibold rounded-full ${
                       item.moneda === 'USD' ? 'text-green-600 bg-green-100' : 'text-blue-600 bg-blue-100'
                     }`}>
                       {item.moneda}
                     </span>
                   </td>
                  <td className="px-6 py-4 whitespace-nowrap">
                    <span className={`inline-flex px-2 py-1 text-xs font-semibold rounded-full ${getMarginColor(item.margen)}`}>
                      {item.margen.toFixed(1)}%
                    </span>
                  </td>
                  <td className="px-6 py-4 whitespace-nowrap text-sm font-medium">
                    <button
                      onClick={() => handleEditPricing(materials.find(m => m.id === item.materialId)!)}
                      className="text-blue-600 hover:text-blue-900 mr-3"
                    >
                      Editar
                    </button>
                    <button className="text-green-600 hover:text-green-900">
                      Presupuesto
                    </button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      {/* Modal de Edición de Precios */}
      {showPricingModal && selectedMaterial && (
        <div className="fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full z-50">
          <div className="relative top-20 mx-auto p-5 border w-96 shadow-lg rounded-md bg-white">
            <div className="mt-3">
              <h3 className="text-lg font-medium text-gray-900 mb-4">
                Editar Precios - {selectedMaterial.nombre}
              </h3>
              <div className="space-y-4">
                <div>
                  <label className="block text-sm font-medium text-gray-700 mb-1">
                    Precio Interno (${selectedMaterial.unidad})
                  </label>
                  <input
                    type="number"
                    step="0.01"
                    value={editingPrices.precio_interno}
                    onChange={(e) => setEditingPrices({
                      ...editingPrices,
                      precio_interno: parseFloat(e.target.value) || 0
                    })}
                    className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                  />
                </div>
                <div>
                  <label className="block text-sm font-medium text-gray-700 mb-1">
                    Precio Cliente (${selectedMaterial.unidad})
                  </label>
                  <input
                    type="number"
                    step="0.01"
                    value={editingPrices.precio_por_m2}
                    onChange={(e) => setEditingPrices({
                      ...editingPrices,
                      precio_por_m2: parseFloat(e.target.value) || 0
                    })}
                    className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                  />
                </div>
                                 <div>
                   <label className="block text-sm font-medium text-gray-700 mb-1">
                     Precio por Unidad
                   </label>
                   <input
                     type="number"
                     step="0.01"
                     value={editingPrices.precio_por_unidad}
                     onChange={(e) => setEditingPrices({
                       ...editingPrices,
                       precio_por_unidad: parseFloat(e.target.value) || 0
                     })}
                     className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                   />
                 </div>
                 <div>
                   <label className="block text-sm font-medium text-gray-700 mb-1">
                     Moneda
                   </label>
                   <select
                     value={editingPrices.moneda}
                     onChange={(e) => setEditingPrices({
                       ...editingPrices,
                       moneda: e.target.value as 'ARS' | 'USD'
                     })}
                     className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                   >
                     <option value="ARS">Pesos Argentinos (ARS)</option>
                     <option value="USD">Dólares Estadounidenses (USD)</option>
                   </select>
                 </div>
                                 <div className="bg-gray-50 p-3 rounded-md">
                   <p className="text-sm text-gray-600">
                     Margen: {calculateMargin(editingPrices.precio_interno, editingPrices.precio_por_m2).toFixed(1)}%
                   </p>
                   {editingPrices.moneda === 'USD' && (
                     <div className="mt-2 pt-2 border-t border-gray-200">
                       <p className="text-xs text-gray-500">
                         Precio Interno: ${(editingPrices.precio_interno * exchangeRate.USD).toFixed(2)} ARS
                       </p>
                       <p className="text-xs text-gray-500">
                         Precio Cliente: ${(editingPrices.precio_por_m2 * exchangeRate.USD).toFixed(2)} ARS
                       </p>
                     </div>
                   )}
                 </div>
              </div>
              <div className="flex justify-end space-x-3 mt-6">
                <button
                  onClick={() => setShowPricingModal(false)}
                  className="px-4 py-2 bg-gray-300 text-gray-700 rounded-md hover:bg-gray-400"
                >
                  Cancelar
                </button>
                <button
                  onClick={handleSavePricing}
                  className="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700"
                >
                  Guardar
                </button>
              </div>
            </div>
          </div>
        </div>
      )}
    </div>
  );
} 