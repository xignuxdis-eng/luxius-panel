  material: string;
  calidad: string;
  alto: number;
  ancho: number;
  copias: number;
  total: number;
  demasias: number;
  accesorios: string[];
  envio: string;
  emergencia: boolean;
  fechaCreacion: Date;
  fechaEntrega: Date;
  observaciones: string;
}
```

